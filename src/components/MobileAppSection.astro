---
const mobileFeatures = [
  { title: 'Find & Enter Tournaments', description: 'Discover events near you, register your spot, and pay your entry without leaving the app' },
  { title: 'Discover & Build Lists', description: 'Browse lists from real events for inspiration, then build and submit your own' },
  { title: 'Play Your Rounds', description: 'Pairings, the round timer, and score entry at the table, with a call button so you are never hunting down the TO' },
  { title: 'Push Notifications', description: 'Know the moment pairings drop, results land, or your list is approved' },
];
---

<section id="mobile" class="bg-white py-16 sm:py-24 scroll-mt-20 dark:bg-gray-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="lg:grid lg:grid-cols-2 lg:gap-16 items-center">
      <!-- Phone + Desktop mockup -->
      <div class="mb-12 lg:mb-0 flex justify-center">
        <div class="relative">
          <!-- Desktop screenshot behind -->
          <div class="w-[min(380px,75vw)] sm:w-[480px] h-[280px] sm:h-[360px] bg-gray-800 rounded-lg shadow-xl overflow-hidden border border-gray-700 translate-x-4 sm:translate-x-10">
            <div class="h-6 bg-gray-700 flex items-center gap-1.5 px-3">
              <div class="w-2.5 h-2.5 rounded-full bg-red-400"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-yellow-400"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-green-400"></div>
            </div>
            <div class="relative w-full h-[calc(100%-1.5rem)] overflow-hidden">
              <img
                src="/images/battle-builder-desktop.webp"
                alt="OWR Battle Builder web app showing army list management with tournament submissions"
                class="absolute bottom-0 right-0 w-[200%] max-w-none"
                loading="lazy"
              />
            </div>
          </div>
          <!-- Phone mockup in front -->
          <div class="absolute -bottom-8 -left-2 sm:-left-8 w-32 sm:w-48 h-[260px] sm:h-[384px] bg-gray-900 rounded-[2rem] sm:rounded-[2.5rem] p-2 sm:p-2.5 shadow-2xl z-10">
            <div class="w-full h-full rounded-[1.5rem] sm:rounded-[2rem] overflow-hidden">
              <img
                src="/images/owr-ios-screenshot.webp"
                alt="OWR mobile app showing an army list with Characters and Core Units"
                class="w-full h-full object-cover object-top"
                loading="lazy"
              />
            </div>
          </div>
          <div class="absolute -top-4 -right-4 w-24 h-24 bg-owr-gold/20 rounded-full blur-2xl"></div>
          <div class="absolute -bottom-4 -left-4 w-32 h-32 bg-gray-200 dark:bg-gray-700 rounded-full blur-2xl"></div>
          <!-- Spacer for the phone overflow -->
          <div class="h-16"></div>
        </div>
      </div>

      <!-- Content -->
      <div>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-owr-gold text-gray-900 text-sm font-medium mb-4">
          OWR Pro
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-4">
          Build Your List. Play Your Tournament.
        </h2>
        <p class="text-gray-500 dark:text-gray-400 mb-8">
          The Warhammer: The Old World hobby in your pocket. Find your next event, register and pay
          in the app, and browse thousands of tournament lists while you build your own. On game
          day, run every round from your phone, from live pairings to the round clock to entering
          your scores at the table.
        </p>

        <div class="space-y-6 mb-8">
          {mobileFeatures.map((feature) => (
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-lg bg-gray-100 dark:bg-gray-800 flex items-center justify-center shrink-0">
                <svg class="h-5 w-5 text-gray-900 dark:text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 dark:text-white mb-1">{feature.title}</h3>
                <p class="text-sm text-gray-500 dark:text-gray-400">{feature.description}</p>
              </div>
            </div>
          ))}
        </div>

        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-green-500/20 text-green-600 dark:text-green-400 text-sm font-medium mb-3">
          Out now on iOS and Android
        </span>
        <div class="flex flex-wrap items-center gap-4">
          <a
            href="https://apps.apple.com/app/id6757371153"
            target="_blank"
            rel="noopener noreferrer"
            class="transition-opacity hover:opacity-80"
          >
            <img src="/images/store/app-store-badge.svg" alt="Download on the App Store" class="h-12 w-auto" loading="lazy" />
          </a>
          <a
            href="https://play.google.com/store/apps/details?id=com.oldworldrankings.android"
            target="_blank"
            rel="noopener noreferrer"
            class="transition-opacity hover:opacity-80"
          >
            <img src="/images/store/google-play-badge.svg" alt="Get it on Google Play" class="h-12 w-auto" loading="lazy" />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
