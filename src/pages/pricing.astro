---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const APP_URL = import.meta.env.PUBLIC_APP_URL || 'https://oldworldrankings.com';

type Feature = { label: string; note?: string; href?: string; isNew?: boolean; isHot?: boolean };

const freeFeatures: Feature[] = [
  { label: 'Battle Builder', note: 'Build, check and submit your army lists', href: `${APP_URL}/builder`, isNew: true },
  { label: 'Battle Scorer', note: 'Score both armies turn by turn, one saved game at a time', href: '/battle-scorer/', isNew: true },
  { label: 'Tournament hosting', note: 'Registrations, list checks, pairings and results', href: '/tournament-organisers/' },
  { label: 'Region and global rankings', note: 'Where every player stands, in your region and worldwide', href: `${APP_URL}/global_rankings` },
  { label: 'Faction stats', note: 'Win rates, trends and leaderboards for every faction', href: `${APP_URL}/faction_stats/v2` },
  { label: 'Galleries', note: 'Painted armies and photos from events', href: `${APP_URL}/galleries` },
  { label: 'Army List Glossary', note: 'Look up terms on 5 army lists a week' },
  { label: 'Browse army lists', note: 'Lists from past events once they are published' },
  { label: 'Play in tournaments', note: 'Pairings and results in the Battle Hub on the day' },
  { label: 'Community features' },
];

const proGroups: { title?: string; items: Feature[] }[] = [
  { items: [{ label: 'Everything in Free' }] },
  {
    title: 'For players',
    items: [
      { label: 'Cloud Sync & Unit Library', note: 'Your lists, games and saved units on every device', href: `${APP_URL}/builder`, isHot: true },
      { label: 'Battle Scorer Game History', note: 'Keep every game you score, not just the one in play', href: '/battle-scorer/', isHot: true },
      { label: 'Game Notes & Photos', note: 'Notes, photos and voice notes during a game', href: '/battle-scorer/', isHot: true },
      { label: 'Who Has It?', note: 'Find every unit in your list that has a given item or rule', href: `${APP_URL}/builder`, isHot: true },
      { label: 'Unlimited Army List Glossary', note: 'Look up terms on every army list, as often as you like', isNew: true },
      { label: 'List Branching', note: 'Try changes side by side, then keep the version you want', href: `${APP_URL}/builder`, isNew: true },
      { label: 'Matchup Ratings', note: 'Mark each list as a good, even or bad matchup', href: `${APP_URL}/builder`, isNew: true },
      { label: 'Digital Lists', note: 'Open any OWR army list in the Battle Builder' },
      { label: 'Early Army List Access', note: 'See event lists before the event finishes' },
      { label: 'Advanced Army Filters', note: 'Filter army lists by more than faction' },
      { label: 'Notifications', note: 'Follows, alerts and the weekly meta' },
      { label: 'Ad-Free', note: 'No ads anywhere on OWR' },
    ],
  },
  {
    title: 'For tournament organisers',
    items: [
      { label: 'Live Pairings', note: 'Reveal round 1 pairings live on the Battle Board', href: '/tournament-organisers/', isHot: true },
      { label: 'Comp Builder', note: 'Build and import comp packs for your events', href: '/tournament-organisers/', isHot: true },
      { label: 'Email Communication', note: 'Email attendees and request list resubmissions', href: '/tournament-organisers/', isHot: true },
      { label: 'Bulk Army List Download', note: 'Every list for your event in one PDF', href: '/tournament-organisers/', isHot: true },
      { label: 'BYO payment links', note: 'Take entry fees through your own payment links at any event size (Free: up to 16 players)', href: '/tournament-organisers/' },
      { label: 'Private Tournaments', note: 'Invitation-only events, coming soon', href: '/tournament-organisers/' },
      { label: 'Tournament Pack AI Assist', note: 'Set up your event from its pack', href: '/tournament-organisers/' },
      { label: 'Presale Dates', note: 'Coming soon', href: '/tournament-organisers/' },
      { label: 'Priority Support', note: 'Your questions answered first' },
    ],
  },
];

---

<Layout
  title="Pricing - Old World Rankings"
  description="Everything you need to compete. Upgrade to Pro to unlock the full experience."
>
  <Nav promoStrip={false} />

  <main class="pt-16 pb-16">
    <div data-promo-only>
      <div class="relative bg-owr-gold text-black overflow-hidden">
        <div class="absolute inset-0 bg-[repeating-linear-gradient(-45deg,rgba(0,0,0,0.07)_0_16px,transparent_16px_32px)]" aria-hidden="true"></div>
        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 flex flex-col md:flex-row md:items-center gap-3 md:gap-8">
          <p class="text-6xl sm:text-7xl font-black uppercase leading-[0.85] tracking-tighter">Black Friday</p>
          <div class="md:border-l-4 md:border-black md:pl-8">
            <p class="text-2xl sm:text-4xl font-black uppercase leading-none">6 months free</p>
            <p class="mt-2 text-base sm:text-lg font-bold">on Pro yearly. Our new yearly price, launching this Black Friday (all month).</p>
          </div>
        </div>
      </div>
    </div>
    <div class="pt-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="text-center mb-16">
        <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4">
          Simple, Transparent Pricing
        </h1>
        <p class="text-lg text-gray-500 dark:text-gray-400 max-w-2xl mx-auto mb-8">
          Everything you need to compete. Upgrade to Pro to unlock the full experience.
        </p>

        <!-- Billing toggle -->
        <div class="inline-flex items-center bg-gray-100 dark:bg-gray-800 rounded-full p-1">
          <button type="button" data-interval="monthly" class="px-5 py-2 text-sm font-medium rounded-full transition-colors text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
            Monthly
          </button>
          <button type="button" data-interval="yearly" class="px-5 py-2 text-sm font-medium rounded-full transition-colors bg-gray-900 text-white dark:bg-white dark:text-gray-900">
            Yearly <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-green-100 text-green-800 font-semibold ml-1">Save 50%</span>
          </button>
        </div>
      </div>

      <!-- Pricing cards -->
      <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto mb-20">
        <!-- Free -->
        <div class="p-8 rounded-2xl border border-gray-200 bg-white dark:bg-gray-800 dark:border-gray-700 flex flex-col">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Free</h2>
          <p class="text-gray-500 dark:text-gray-400 mb-6">Everything you need to compete</p>
          <p class="text-4xl font-bold text-gray-900 dark:text-white mb-8">
            $0<span class="text-lg font-normal text-gray-500 dark:text-gray-400" data-free-suffix> USD/month</span>
          </p>
          <ul class="space-y-4 flex-grow">
            {freeFeatures.map((f) => (
              <li class="flex items-start gap-3 text-gray-700 dark:text-gray-300">
                <svg class="h-5 w-5 mt-0.5 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span>
                  {f.href ? <a href={f.href} class="underline underline-offset-4 hover:text-owr-gold-dark dark:hover:text-owr-gold">{f.label}</a> : f.label}
                  {f.note && <span class="block text-xs text-gray-500 dark:text-gray-400">{f.note}</span>}
                </span>
                {f.isNew && <span class="ml-auto shrink-0 whitespace-nowrap text-[10px] px-1.5 py-0.5 rounded-full bg-green-500 text-white font-semibold">NEW</span>}
              </li>
            ))}
          </ul>
          <a
            href={`${APP_URL}/register`}
            class="block w-full py-3 text-center border border-gray-300 text-gray-900 font-medium rounded-lg hover:bg-gray-50 dark:border-gray-600 dark:text-white dark:hover:bg-gray-700 transition-colors mt-8"
          >
            Get Started Free
          </a>
        </div>

        <!-- Pro -->
        <div class="p-8 rounded-2xl border-2 border-owr-gold bg-white dark:bg-gray-800 relative flex flex-col">
          <div class="absolute -top-3 left-1/2 -translate-x-1/2">
            <span class="px-4 py-1 rounded-full bg-owr-gold text-gray-900 text-sm font-semibold">
              <span data-promo-hide>RECOMMENDED</span><span data-promo-only>BLACK FRIDAY</span>
            </span>
          </div>
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Pro</h2>
          <p class="text-gray-500 dark:text-gray-400 mb-6">For organizers &amp; power users</p>
          <p class="text-4xl font-bold text-gray-900 dark:text-white mb-1">
            <span data-pro-price>$3.50</span><span class="text-lg font-normal text-gray-500 dark:text-gray-400" data-pro-suffix> USD/month</span>
          </p>
          <p class="text-xs text-gray-400 dark:text-gray-500 mb-6" data-billing-note><span data-note-text>Billed yearly (6 months free).</span><span data-promo-only><span data-was-wrap> <s data-was></s></span></span></p>
          <ul class="space-y-4 flex-grow">
            {proGroups.map((group) => (<Fragment>
              {group.title && <li class="pt-3 text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400">{group.title}</li>}
              {group.items.map((f) => (
              <li class:list={["flex items-start gap-3", f.isHot ? "text-gray-900 dark:text-white font-semibold" : "text-gray-700 dark:text-gray-300"]}>
                <svg class:list={["h-5 w-5 mt-0.5 shrink-0", f.isHot ? "text-owr-gold" : "text-owr-gold-dark dark:text-owr-gold"]} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span>
                  {f.href ? <a href={f.href} class="underline underline-offset-4 hover:text-owr-gold-dark dark:hover:text-owr-gold">{f.label}</a> : f.label}
                  {f.note && <span class="block text-xs font-normal text-gray-500 dark:text-gray-400">{f.note}</span>}
                </span>
                {f.isNew && <span class="ml-auto shrink-0 whitespace-nowrap text-[10px] px-1.5 py-0.5 rounded-full bg-owr-gold text-gray-900 font-semibold">NEW</span>}
                {f.isHot && <span class="ml-auto shrink-0 whitespace-nowrap text-[10px] px-1.5 py-0.5 rounded-full bg-owr-gold text-gray-900 font-semibold">🔥 HOT</span>}
              </li>
              ))}
            </Fragment>))}
            <li class="flex items-center gap-3 text-gray-700 dark:text-gray-300 pt-3 border-t border-gray-200 dark:border-gray-700">
              <svg class="h-5 w-5 text-owr-gold-dark dark:text-owr-gold shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span class="font-semibold text-gray-900 dark:text-white">Support the continued development of Old World Rankings</span>
            </li>
          </ul>
          <a
            href={`${APP_URL}/purchase`}
            class="block w-full py-3 text-center bg-gray-900 text-white font-medium rounded-lg hover:bg-gray-800 transition-colors mt-8"
          >
            Upgrade to Pro
          </a>
        </div>
      </div>

    </div>
    </div>
  </main>

  <Footer />

  <script>
    import { detectCurrency, priceForCurrency, yearTotals, type BillingInterval } from '../lib/pricing';

    let currentInterval: BillingInterval = 'yearly';

    function updatePricing() {
      const user = window.__owrUser;
      const currency = detectCurrency(user?.region_slug);
      const price = priceForCurrency(currency, currentInterval);

      const priceEl = document.querySelector('[data-pro-price]');
      const suffixEl = document.querySelector('[data-pro-suffix]');
      const freeSuffixEl = document.querySelector('[data-free-suffix]');
      const billingNote = document.querySelector('[data-billing-note]');
      if (priceEl) priceEl.textContent = price.display;
      if (suffixEl) suffixEl.textContent = ` ${price.suffix}`;
      if (freeSuffixEl) freeSuffixEl.textContent = ` ${price.suffix}`;
      if (billingNote) {
        const yearly = currentInterval === 'yearly';
        const totals = yearTotals(currency);
        billingNote.querySelector('[data-note-text]')?.replaceChildren(yearly ? `Billed yearly at ${totals.total} (6 months free).` : 'Billed monthly.');
        billingNote.querySelector('[data-was]')?.replaceChildren(`Was ${totals.was}`);
        billingNote.querySelector<HTMLElement>('[data-was-wrap]')?.toggleAttribute('hidden', !yearly);
      }
    }

    // Toggle buttons
    const toggleBtns = document.querySelectorAll<HTMLButtonElement>('[data-interval]');
    const activeClasses = ['bg-gray-900', 'text-white', 'dark:bg-white', 'dark:text-gray-900'];
    const inactiveClasses = ['text-gray-500', 'hover:text-gray-700', 'dark:text-gray-400', 'dark:hover:text-gray-200'];

    toggleBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentInterval = btn.dataset.interval as BillingInterval;
        toggleBtns.forEach((b) => {
          const isActive = b.dataset.interval === currentInterval;
          activeClasses.forEach((c) => b.classList.toggle(c, isActive));
          inactiveClasses.forEach((c) => b.classList.toggle(c, !isActive));
        });
        updatePricing();
      });
    });

    document.addEventListener('owr:user-loaded', () => updatePricing());
    if (window.__owrUser !== undefined) updatePricing();
  </script>
</Layout>
