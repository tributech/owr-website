---
// Temporary Black Friday takeover (OWR-1012): shown in the promo window in place of ScorerFeature.
import { ArrowRight, ChevronDown, X, Swords, Hammer, CalendarArrowUp, Trophy, MapPin, Play } from '@lucide/astro';
import { SCORER_VIDEO_URL, youtubeId } from '../../lib/youtube';

const APP_URL = import.meta.env.PUBLIC_APP_URL || 'https://oldworldrankings.com';
const videoId = youtubeId(SCORER_VIDEO_URL);

const jumps = [
  { label: 'Battle Scorer', href: '/battle-scorer/', icon: Swords, color: 'text-owr-gold' },
  { label: 'Battle Builder', href: `${APP_URL}/builder`, icon: Hammer, color: 'text-owr-gold' },
  { label: 'Find an event', href: `${APP_URL}/upcoming`, icon: CalendarArrowUp, color: 'text-teal-400' },
  { label: 'Rankings', href: `${APP_URL}/global_rankings`, icon: Trophy, color: 'text-amber-400' },
  { label: 'Your region', href: '#home-main', icon: MapPin, color: 'text-sky-400' },
];

const features = [
  'Game History', 'Rules Search', 'Digital Lists',
  'Builder Sync', 'Comp Builder', 'Email Your Players',
];
---

<section id="black-friday" class="relative overflow-hidden bg-black text-white pt-16">
  <div class="absolute inset-0" aria-hidden="true">
    <img src="/images/landing/image3.jpg" alt="" class="absolute inset-0 w-full h-full object-cover opacity-[0.10]" />
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_70%_45%,rgba(255,215,0,0.24),transparent_55%)]"></div>
    <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-b from-transparent to-black"></div>
  </div>

  <div class="relative bg-owr-gold text-black overflow-hidden">
    <div class="absolute inset-0 bg-[repeating-linear-gradient(-45deg,rgba(0,0,0,0.07)_0_16px,transparent_16px_32px)]" aria-hidden="true"></div>
    <button type="button" data-bf-close aria-label="Close the Black Friday offer" class="absolute top-3 right-3 sm:top-4 sm:right-4 z-10 size-10 sm:size-12 flex items-center justify-center rounded-full bg-black text-owr-gold hover:bg-gray-800 cursor-pointer transition-colors">
      <X size={26} strokeWidth={3} />
    </button>
    <div class="relative max-w-7xl mx-auto px-4 pr-16 sm:px-6 sm:pr-20 lg:px-8 py-4 sm:py-8 flex flex-col lg:flex-row lg:items-center gap-2 sm:gap-3 lg:gap-10">
      <h2 class="whitespace-nowrap text-[clamp(1.9rem,8.5vw,3rem)] sm:text-8xl xl:text-9xl font-black uppercase leading-[0.85] tracking-tighter">Black Friday</h2>
      <div class="lg:border-l-4 lg:border-black lg:pl-8">
        <p class="text-2xl sm:text-5xl font-black uppercase leading-none">6 months free</p>
        <p class="hidden sm:block mt-2 text-lg sm:text-xl font-bold">on OWR Pro yearly. Save 50% against paying monthly.</p>
        <p class="sm:hidden mt-1.5 text-sm font-bold tabular-nums">Pro yearly <span class="text-base font-black" data-bf-month>$3.50</span>/month, <span data-bf-year>$41.99</span> billed yearly</p>
      </div>
    </div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-5 sm:pt-12 pb-8 sm:pb-16 grid grid-cols-1 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-6 sm:gap-10 lg:gap-8 items-center">
    <div>
      <div class="hidden sm:block">
      <p class="text-sm font-bold uppercase tracking-[0.18em] text-owr-gold">OWR Pro yearly</p>
      <div class="mt-3 flex flex-wrap items-end gap-x-5 gap-y-2 tabular-nums">
        <p class="leading-none"><span class="text-6xl sm:text-7xl xl:text-8xl font-black tracking-tight" data-bf-month>$3.50</span><span class="text-xl text-white/60 font-bold">/month</span></p>
        <p class="text-sm text-white/60 pb-1"><span class="font-bold text-white" data-bf-year>$41.99</span> billed yearly<br /><span class="line-through" data-bf-monthly-year>$83.88</span> paying monthly</p>
      </div>
      <p class="mt-5 text-xl sm:text-2xl font-bold text-owr-gold">Our new yearly price, launching this Black Friday (all month).</p>
      <ul class="mt-6 grid grid-cols-[repeat(3,max-content)] gap-x-5 gap-y-2.5 text-sm">
        {features.map((f) => (
          <li class="flex items-center gap-2 text-white/90 whitespace-nowrap"><span class="size-1.5 shrink-0 rotate-45 bg-owr-gold"></span>{f}</li>
        ))}
      </ul>
      </div>
      <div class="sm:mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
        <a href={`${APP_URL}/purchase`} class="h-12 flex items-center gap-2 px-6 rounded-lg bg-owr-gold hover:bg-owr-gold-dark text-gray-900 font-extrabold text-lg shadow-[0_0_30px_-6px_rgba(255,215,0,0.6)] transition-colors">Get Pro <ArrowRight size={18} strokeWidth={2.5} /></a>
        <a href="/pricing/" class="font-semibold text-white/80 hover:text-owr-gold underline underline-offset-4">Compare plans</a>
        {videoId && (
          <a data-scorer-watch href={`https://www.youtube.com/watch?v=${videoId}`} data-video-id={videoId} target="_blank" rel="noopener noreferrer" class="group flex items-center gap-2.5 font-semibold text-white hover:text-owr-gold transition-colors">
            <span class="size-10 flex items-center justify-center rounded-full border-2 border-white/70 group-hover:border-owr-gold transition-colors"><Play size={16} strokeWidth={2.5} class="ml-0.5 fill-current" /></span>
            Watch the video
          </a>
        )}
      </div>
    </div>

    <div class="relative pb-10 sm:pb-14 lg:pl-6" aria-hidden="true">
      <div class="rounded-[1.6rem] sm:rounded-[2rem] border-[8px] sm:border-[12px] border-neutral-800 bg-black shadow-[0_30px_80px_rgba(0,0,0,0.8)] overflow-hidden">
        <video class="scorer-loop block w-full aspect-[4/3]" src="/images/scorer/ipad-loop.mp4" poster="/images/scorer/ipad-loop.webp" autoplay muted loop playsinline preload="auto"></video>
      </div>
      <div class="absolute -left-2 sm:-left-6 bottom-0 w-[30%] sm:w-[26%] rounded-[1.4rem] sm:rounded-[2rem] border-[5px] sm:border-[7px] border-neutral-800 bg-black shadow-[0_25px_60px_rgba(0,0,0,0.85)] overflow-hidden">
        <video class="scorer-loop block w-full aspect-[420/914]" src="/images/scorer/iphone-loop.mp4" poster="/images/scorer/iphone-loop.webp" autoplay muted loop playsinline preload="auto"></video>
      </div>
      <div class="absolute -top-3 right-2 sm:right-6 rotate-6 rounded-full bg-owr-gold text-black size-20 sm:size-28 flex flex-col items-center justify-center text-center shadow-[0_10px_30px_rgba(255,215,0,0.35)]">
        <span class="text-2xl sm:text-4xl font-black leading-none">50%</span>
        <span class="text-[10px] font-extrabold uppercase tracking-wider leading-tight">less than<br />monthly</span>
      </div>
    </div>
  </div>

  <div class="relative border-t border-white/10 bg-white/[0.04] backdrop-blur">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-col md:flex-row md:items-center gap-3 md:gap-5">
      <p class="text-sm font-semibold text-white/70 shrink-0">Here for something else?</p>
      <nav aria-label="Jump to" class="flex gap-2 overflow-x-auto -mx-4 px-4 md:mx-0 md:px-0 md:flex-1">
        {jumps.map((j) => (
          <a href={j.href} class="shrink-0 h-9 flex items-center gap-1.5 px-3.5 rounded-full bg-white/10 border border-white/15 hover:bg-white/[0.16] text-[13px] font-semibold text-white transition-colors">
            <span class={j.color}><j.icon size={15} strokeWidth={2} /></span>{j.label}
          </a>
        ))}
      </nav>
      <a href="#home-main" class="group shrink-0 h-11 flex items-center justify-center gap-2 px-5 rounded-lg border-2 border-white/70 hover:border-owr-gold hover:text-owr-gold text-white font-bold text-sm transition-colors">
        Rankings, events and more <ChevronDown size={18} strokeWidth={2.5} class="group-hover:translate-y-0.5 transition-transform" />
      </a>
    </div>
  </div>
</section>

<script>
  import { detectCurrency, priceForCurrency, yearTotals } from '../../lib/pricing';

  function render() {
    const currency = detectCurrency(window.__owrUser?.region_slug);
    const totals = yearTotals(currency);
    const set = (sel: string, text: string) => document.querySelectorAll(`#black-friday ${sel}`).forEach((el) => el.replaceChildren(text));
    set('[data-bf-month]', priceForCurrency(currency, 'yearly').display);
    set('[data-bf-year]', totals.total);
    set('[data-bf-monthly-year]', totals.monthlyForYear);
  }

  render();
  document.addEventListener('owr:user-loaded', render);
</script>
