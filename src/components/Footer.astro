---
import { APP_STORE_URL, PLAY_STORE_URL } from '../lib/store-links';

const APP_URL = import.meta.env.PUBLIC_APP_URL || 'https://oldworldrankings.com';
const currentYear = new Date().getFullYear();

const platformLinks = [
  { label: 'Rankings', href: `${APP_URL}/global_rankings` },
  { label: 'Tournaments', href: `${APP_URL}/upcoming` },
  { label: 'Battle Builder', href: `${APP_URL}/builder` },
  { label: 'Army Lists', href: `${APP_URL}/army_lists` },
  { label: 'Galleries', href: `${APP_URL}/galleries` },
  { label: 'Pricing', href: '/pricing' },
];

const communityLinks = [
  { label: 'Find Local Scene', href: '/#region' },
  { label: 'Discord', href: 'https://discord.gg/sdqTWHvYUG', external: true },
  { label: 'Insights', href: '/insights/' },
];

const resourceLinks = [
  { label: 'Help & Docs', href: '/docs' },
  { label: "What's New", href: `${APP_URL}/release-notes` },
  { label: 'Newsletter', href: '/newsletter/' },
  { label: 'Roadmap', href: '/roadmap' },
  { label: 'Support', href: '/support' },
  { label: 'Status', href: 'https://status.oldworldrankings.com', external: true },
  { label: 'Sponsor OWR', href: '/sponsor-deck', nofollow: true },
];

const legalLinks = [
  { label: 'Terms of Service', href: '/terms' },
  { label: 'Privacy Policy', href: '/privacy' },
  { label: 'Cookie Policy', href: '/cookies' },
  { label: 'Your Data Rights', href: '/data-rights' },
  { label: 'Third-Party Services', href: '/third-parties' },
];
---

<footer class="bg-gray-900 text-white border-t border-gray-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="grid grid-cols-2 md:grid-cols-6 gap-8 mb-12">
      <!-- Brand -->
      <div class="col-span-2">
        <a href="/" class="flex items-center gap-3 mb-4">
          <img src="/images/owr_logo_white.png" alt="Old World Rankings" class="w-10 h-10" />
          <span class="font-semibold text-white">OWR</span>
        </a>
        <p class="text-sm text-gray-400 mb-4">
          The complete companion for Warhammer: The Old World.
        </p>
        <p class="text-xs text-gray-500 mb-4">Powered by <a href="https://hammerhub.com" target="_blank" rel="noopener noreferrer" class="hover:text-gray-300 transition-colors">HammerHub</a></p>
        <div class="flex flex-wrap items-start gap-2">
          <a
            href={APP_STORE_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="transition-opacity hover:opacity-80"
          >
            <img src="/images/store/app-store-badge.svg" alt="Download on the App Store" class="h-9 w-auto" loading="lazy" />
          </a>
          <a
            href={PLAY_STORE_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="transition-opacity hover:opacity-80"
          >
            <img src="/images/store/google-play-badge.svg" alt="Get it on Google Play" class="h-9 w-auto" loading="lazy" />
          </a>
        </div>
      </div>

      <!-- Platform -->
      <div>
        <h3 class="font-semibold text-white mb-4">Platform</h3>
        <ul class="space-y-3">
          {platformLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-gray-400 hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Community -->
      <div>
        <h3 class="font-semibold text-white mb-4">Community</h3>
        <ul class="space-y-3">
          {communityLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-gray-400 hover:text-white transition-colors"
                {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h3 class="font-semibold text-white mb-4">Resources</h3>
        <ul class="space-y-3">
          {resourceLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-gray-400 hover:text-white transition-colors"
                {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                {...(link.nofollow ? { rel: 'nofollow' } : {})}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h3 class="font-semibold text-white mb-4">Legal</h3>
        <ul class="space-y-3">
          {legalLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-gray-400 hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="pt-8 border-t border-gray-800 flex flex-col gap-3 text-xs text-gray-500 text-center">
      <p>&copy; {currentYear} Old World Rankings. All rights reserved.</p>
      <p>Battle Builder powered by <a href="https://old-world-builder.com" target="_blank" rel="noopener noreferrer" class="hover:text-gray-300 transition-colors">Old World Builder</a>.</p>
      <p>Not affiliated with Games Workshop. Warhammer: The Old World is a trademark of Games Workshop.</p>
      <p>Google Play and the Google Play logo are trademarks of Google LLC. App Store is a service mark of Apple Inc.</p>
    </div>
  </div>
</footer>
