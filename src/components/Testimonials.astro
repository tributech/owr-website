---
// Player and TO quotes in the dark testimonial style of the For Tournament
// Organisers page. Quotes come from owr-marketing/testimonials/testimonials.json:
// copy only the quote text and its anonymous or region credit, never a name.
interface Quote {
  quote: string;
  credit: string;
}

interface Props {
  title?: string;
  quotes: Quote[];
}

const { title = 'What Players Say', quotes } = Astro.props;
---

<section class="py-16 sm:py-24 bg-gray-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-2xl sm:text-3xl font-bold text-white mb-10 text-center">{title}</h2>
    <div class="grid gap-6 md:grid-cols-3">
      {quotes.map((q) => (
        <figure class="border-l-4 border-owr-gold pl-6 flex flex-col">
          <svg class="h-8 w-8 text-owr-gold/30 mb-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4.583 17.321C3.553 16.227 3 15 3 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311 1.804.167 3.226 1.648 3.226 3.489a3.5 3.5 0 0 1-3.5 3.5c-1.073 0-2.099-.49-2.748-1.179zm10 0C13.553 16.227 13 15 13 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311 1.804.167 3.226 1.648 3.226 3.489a3.5 3.5 0 0 1-3.5 3.5c-1.073 0-2.099-.49-2.748-1.179z" />
          </svg>
          <blockquote class="text-lg text-white font-medium leading-relaxed mb-4 flex-1">{q.quote}</blockquote>
          <figcaption class="text-gray-400 text-sm">{q.credit}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
