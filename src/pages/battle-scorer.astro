---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Testimonials from '../components/Testimonials.astro';
import FeatureRows from '../components/FeatureRows.astro';
import { APP_STORE_URL, PLAY_STORE_URL } from '../lib/store-links';

const APP_URL = import.meta.env.PUBLIC_APP_URL || 'https://oldworldrankings.com';
const startHref = `${APP_URL}/builder/games`;

// From owr-marketing testimonials.json (q001 public version, q006, q016); used_in records website:/battle-scorer.
const quotes = [
  { quote: "Easily the best experience as a player for a hosting app. Don't see a point in ever using [the other app] again.", credit: 'Player, Square Based Open Toronto 2026' },
  { quote: "You've created an awesome product, I hope it becomes standard for tournaments.", credit: 'Player, Legacies of War III' },
  { quote: "The app was useful in that I could go to the table numbered, check I've got the right opponent, and introduce myself.", credit: "Player, The Dodgy Dealer's Gambit Part 1" },
];

// Real iPhone captures for the strip under the hero.
const strip = [
  { image: '/images/battle-scorer/strip-builder.webp', caption: 'Build your list in Battle Builder, then play it.', alt: 'Battle Builder on iPhone: a Vampire Counts list with characters, their kit and points' },
  { image: '/images/battle-scorer/strip-tools.webp', caption: 'Quick lookups like template hits, mid-game.', alt: 'The template hits tool: 5 files by 4 ranks under a 3 inch blast, 2 hit and 14 partially' },
  { image: '/images/battle-scorer/strip-final.webp', caption: 'The final score, every VP accounted for.', alt: 'The final score screen: units destroyed for both sides and the common objectives, a victory by 699 VP' },
  { image: '/images/battle-scorer/strip-report.webp', caption: 'A battle report with your own table photos.', alt: 'The battle report: round by round scores with photos taken at the table' },
];

const gameSteps = [
  { number: '1', label: 'Pick lists' },
  { number: '2', label: 'Pre-game' },
  { number: '3', label: 'Play' },
  { number: '4', label: 'Report' },
];

// Every image is a real capture from the app.
const sections = [
  {
    pill: 'Turn by turn',
    title: 'Both Armies, Turn by Turn',
    body: "Both lists are there for the whole game. When a unit dies, flees or drops below half, tap Score and the Victory Points go to the right side straight away. On a phone you tap between your army and your opponent's, and the running score sits at the top.",
    points: [
      ['You are blue, they are orange', 'everywhere, so a score in the wrong column stands out'],
      ['Every unit folded down', 'to what you need mid-game'],
      ['End Turn has undo', 'for when you tap the wrong thing'],
    ],
    image: '/images/battle-scorer/both-armies.webp',
    alt: 'The Battle Scorer in round 5: both scores at the top, and units marked dead with their Victory Points',
  },
  {
    pill: 'Spells',
    title: 'Your Spells, by Caster or by Phase',
    body: "Every known spell for both sides, with its casting value, range and full text. Sort them by the wizard casting them, or by phase, so in the Shooting phase you're only looking at shooting spells.",
    points: [
      ['Your wizards and theirs', 'one tap apart'],
      ['Spells sorted out in the pre-game', 'so they are ready on turn one'],
    ],
    image: '/images/battle-scorer/spells-by-phase.webp',
    alt: 'The spells panel sorted by phase, showing Strategy, Shooting and Combat spells with casting value and range',
  },
  {
    pill: 'Rules tables',
    title: "The Tables You'd Dig Through a Book For",
    body: "The rules you always end up looking for mid-game are a tap away, worked out for your units and your wizards.",
    points: [
      ['Casting odds', "each wizard's chance to cast every spell, and to miscast"],
      ['Miscast and Gaze of the Gods', 'roll for you and show the result'],
      ['Template hits', 'how many models a 3" or 5" blast catches'],
      ['Break tests, to hit and to wound', 'without the maths'],
    ],
    image: '/images/battle-scorer/rules-tables.webp',
    alt: 'The tools panel: to hit, to wound, break test, casting odds, template hits and the core tables including Miscast',
  },
  {
    pill: 'Victory Points',
    title: 'VP and Objectives Added Up for You',
    body: 'Scenario and battle objectives score when they should: at the end of a round, after a player turn, or at the end of the game. The end-of-turn sheet walks you through each one before you move on, so nothing gets missed.',
    points: [
      ['Baggage trains, markers, The King is Dead', 'and the rest of the scenario objectives'],
      ['Secret objectives', 'stay hidden until the end, then count'],
    ],
    image: '/images/battle-scorer/objectives.webp',
    alt: 'Objectives for round 5 with Victory Points added for The King is Dead, Control the Christmas Tree and markers held',
  },
  {
    pill: 'Battle report',
    title: 'A Battle Report at the End',
    body: "When the game's done you get every scoring line for both sides, then a battle report of the whole game, turn by turn. Take photos as you go and they're in there too.",
    points: [
      ['Every turn', 'with what scored and who scored it'],
      ['Share it', "from your phone's share sheet"],
    ],
    image: '/images/battle-scorer/battle-report.webp',
    alt: 'The battle report: a victory by 1525 VP, then round 1 with each turn and its scoring lines',
  },
  {
    pill: 'iPad',
    title: 'Two Columns on iPad',
    body: 'On an iPad or Android tablet both armies sit side by side, with the tools and spells in a panel down the side. The pre-game, the end-of-turn sheet and the battle report all spread out to use the room.',
    points: [
      ['Both armies on one screen', 'no switching'],
      ['Landscape or portrait', 'whichever way the tablet sits'],
    ],
    image: '/images/battle-scorer/ipad-two-column.webp',
    alt: 'The Battle Scorer on iPad with the tools panel on the left and both armies side by side',
    wide: true,
  },
  {
    pill: 'At OWR events',
    title: 'Straight to the TO at OWR Events',
    body: "At an event run on OWR, open your round in the Battle Hub and play it in the Battle Scorer. The scenario and both lists come with it, and when you finish, the result and its full breakdown go straight to the TO.",
    points: [
      ['Nothing to type in again', 'the score is already there'],
      ['The full breakdown', 'so the TO can see where every point came from'],
    ],
    image: '/images/battle-scorer/battle-hub.webp',
    alt: 'The Battle Hub after the game: result in, with the score breakdown sent to the event',
  },
];
---

<Layout
  title="Battle Scorer - Old World Rankings"
  description="Score any game of The Old World turn by turn: both armies, spells, casting odds and the rules tables, Victory Points and objectives added up for you, and a battle report at the end. On the web, iPhone, iPad and Android."
  ogImage="/images/newsletter/oct-2026-video-poster.jpg"
>
  <Nav />

  <main>
    <!-- HERO - copy on the left, real iPhone and iPad Battle Scorer captures on the right -->
    <section class="relative pt-24 pb-14 sm:pt-36 sm:pb-24 overflow-hidden bg-gray-900">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_75%_40%,rgba(255,215,0,0.12),transparent_60%)]" aria-hidden="true"></div>
      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 lg:grid lg:grid-cols-12 lg:gap-12 items-center">
        <div class="lg:col-span-5 text-center lg:text-left mb-10 lg:mb-0">
          <span class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/10 text-white text-sm font-medium mb-6">
            The Battle Scorer
          </span>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-4 sm:mb-6">
            Score Your Games of The Old World, Turn by Turn
          </h1>
          <p class="text-base sm:text-lg text-gray-300 mb-6 sm:mb-8 max-w-xl mx-auto lg:mx-0">
            Pick both lists and play. VP, objectives, spells and the rules tables are all there as you go. On the web, iPhone, iPad and Android.
          </p>
          <div class="flex flex-row items-center justify-center lg:justify-start gap-3 sm:gap-4">
            <a
              href={startHref}
              class="flex-1 sm:flex-none px-6 sm:px-8 py-3 bg-owr-gold text-gray-900 font-semibold rounded-lg hover:bg-owr-gold-dark transition-colors text-center"
            >
              Start a game
            </a>
            <a
              href="/app/"
              class="flex-1 sm:flex-none px-6 sm:px-8 py-3 border border-white/30 text-white font-medium rounded-lg hover:bg-white/10 transition-colors text-center"
            >
              Get the app
            </a>
          </div>
        </div>

        <div class="lg:col-span-7">
          <div class="relative mx-auto max-w-2xl pt-[6%] pb-[16%] pl-[16%] sm:pl-[20%]">
            <img
              src="/images/battle-scorer/hero-ipad-scorer-sharp.webp"
              alt="The Battle Scorer on iPad: tools down the side, both armies side by side, the score at the top and the Movement phase button at the bottom"
              width="1500" height="1125"
              fetchpriority="high"
              class="w-full h-auto rounded-2xl border-[6px] border-gray-700 shadow-2xl shadow-black/60"
            />
            <img
              src="/images/battle-scorer/hero-iphone-scorer.webp"
              alt="The Battle Scorer on iPhone in round 5: the running score, a Destroyed group with the Skaven Chieftain and Clanrats, and the Movement phase button"
              width="720" height="1564"
              fetchpriority="high"
              class="absolute left-0 bottom-0 w-[34%] sm:w-[31%] h-auto rounded-[1.6rem] sm:rounded-[2rem] border-[5px] sm:border-[6px] border-gray-700 shadow-2xl shadow-black/70"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- SCREENS STRIP - more real captures, one line each -->
    <section class="py-16 sm:py-20 bg-gray-50 dark:bg-gray-800">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-10 text-center">
          From Your List to the Final Score
        </h2>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
          {strip.map((shot) => (
            <figure>
              <img
                src={shot.image}
                alt={shot.alt}
                width="600" height="1304"
                loading="lazy"
                class="w-full h-auto rounded-[1.4rem] border-4 border-gray-800 dark:border-gray-700 shadow-lg"
              />
              <figcaption class="mt-3 text-sm text-gray-600 dark:text-gray-400 text-center">{shot.caption}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- GAME PROGRESS BAR -->
    <section class="py-16 sm:py-20 bg-white dark:bg-gray-900">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-4">
            From Deployment to the Final Score
          </h2>
          <p class="text-gray-500 dark:text-gray-400 max-w-xl mx-auto">
            The pre-game walks you through it in order: rounds and the optional chess clock, the scenario and its deployment map, spells for both sides, and who goes first.
          </p>
        </div>

        <div class="flex items-center justify-between max-w-xs sm:max-w-2xl mx-auto px-2 sm:px-0">
          {gameSteps.map((step, i) => (
            <div class="flex items-center flex-1 last:flex-none">
              <div class="flex flex-col items-center">
                <div class="w-10 h-10 rounded-full bg-owr-gold text-gray-900 font-bold text-sm flex items-center justify-center shrink-0">
                  {step.number}
                </div>
                <span class="text-xs font-medium text-gray-600 dark:text-gray-400 mt-2 whitespace-nowrap">{step.label}</span>
              </div>
              {i < gameSteps.length - 1 && (
                <div class="flex-1 h-0.5 bg-owr-gold/30 mx-2 sm:mx-4 mb-6 min-w-4"></div>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <FeatureRows sections={sections} />

    <Testimonials quotes={quotes} />

    <!-- FINAL CTA - Dark bg, download links -->
    <section id="download" class="relative py-20 sm:py-28 overflow-hidden scroll-mt-16">
      <div class="absolute inset-0 bg-gray-900">
      </div>
      <div class="relative z-10 max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white mb-6">
          Ready for Your Next Game?
        </h2>
        <p class="text-lg text-gray-400 mb-10 max-w-xl mx-auto">
          The Battle Scorer is on the web, and in the OWR app on iPhone, iPad and Android.
        </p>
        <a
          href={startHref}
          class="inline-block px-10 py-4 bg-owr-gold text-gray-900 font-semibold rounded-lg hover:bg-owr-gold-dark transition-colors text-lg"
        >
          Start a Game on the Web
        </a>
        <div class="mt-8 flex items-center justify-center gap-3">
          <a href={APP_STORE_URL} target="_blank" rel="noopener noreferrer"><img src="/images/store/app-store-badge.svg" alt="Download on the App Store" class="h-12 w-auto" /></a>
          <a href={PLAY_STORE_URL} target="_blank" rel="noopener noreferrer"><img src="/images/store/google-play-badge.svg" alt="Get it on Google Play" class="h-12 w-auto" /></a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

</Layout>
