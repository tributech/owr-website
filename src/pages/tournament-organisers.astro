---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Testimonials from '../components/Testimonials.astro';
import FeatureRows, { type FeatureSection } from '../components/FeatureRows.astro';

const APP_URL = import.meta.env.PUBLIC_APP_URL || 'https://oldworldrankings.com';
const HELP = 'https://help.oldworldrankings.com/articles/';

const highlights = [
  { title: 'Registrations', description: 'Sign-ups, entry fees and the waitlist', icon: 'M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 0 0 2.25-2.25V6.75A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25v10.5A2.25 2.25 0 0 0 4.5 19.5Z' },
  { title: 'List Checks', description: 'Lists checked against your comp', icon: 'm4.5 12.75 6 6 9-13.5' },
  { title: 'Pairings', description: 'Swiss pairings with manual override', icon: 'M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5' },
  { title: 'Battle Board', description: 'Live pairings and timer on a big screen', icon: 'M3.75 3v11.25A2.25 2.25 0 0 0 6 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0 1 18 16.5h-2.25m-7.5 0h7.5m-7.5 0-1 3m8.5-3 1 3m0 0 .5 1.5m-.5-1.5h-9.5m0 0-.5 1.5' },
];

// Painted armies from public OWR galleries, credited by army and the owner's region only.
const galleryPhotos = [
  { src: '/images/for-tournament-organisers/gallery/army-1.webp', credit: 'Daemons of Chaos: Player, United States' },
  { src: '/images/for-tournament-organisers/gallery/army-2.webp', credit: 'Chracian Warhost: Player, Australia' },
  { src: '/images/for-tournament-organisers/gallery/army-3.webp', credit: 'Warriors of Chaos: Player, Canada' },
  { src: '/images/for-tournament-organisers/gallery/army-4.webp', credit: 'Daemons of Chaos: Player, Canada' },
  { src: '/images/for-tournament-organisers/gallery/army-5.webp', credit: 'Chracian Warhost: Player, Australia' },
];

// Pro is extra for TOs who want more; hosting itself is free. Taken from the Pro list on /pricing.
const proExtras = [
  { title: 'Tournament Pack AI Assist', description: 'Upload your player pack and your event details are filled in for you.' },
  { title: 'Email Communication', description: 'Email your attendees from OWR, and their replies come back to you.' },
  { title: 'Private Tournaments', description: 'Run an event that is only for the players you invite.' },
  { title: 'Presale Dates', description: 'Give some players a window to register before everyone else.' },
  { title: 'Bulk Army List Download', description: 'Download every list for your event in one go.' },
  { title: 'Priority Support', description: 'Your questions go to the front of the queue.' },
];

const lifecycleSteps = [
  { number: '1', label: 'Create' },
  { number: '2', label: 'Setup' },
  { number: '3', label: 'Game Day' },
  { number: '4', label: 'Results' },
];

// Every image is a real capture from OWR.
const sections: FeatureSection[] = [
  {
    pill: 'Registrations',
    title: 'Registrations, Payments and the Waitlist',
    body: 'Players sign up and pay through OWR, and you see everyone in one list: who has paid, who has sent a list, and who is on the waitlist.',
    points: [
      ['Entry fees through Stripe', 'paid out to you'],
      ['A waitlist', 'for when you sell out'],
      ['Check-in on the day', 'with late arrivals and no-shows handled'],
    ],
    image: '/images/for-tournament-organisers/for-tos-2.png',
    alt: 'The Attendees tab with each player, their payment and list status',
    wide: true,
    link: { label: 'Help: Attendees', href: `${HELP}attendees` },
  },
  {
    pill: 'Lists and comp',
    title: 'Custom Comps and List Checks',
    body: 'Any comp you set up for your event flows into Battle Builder, so every player builds and checks their list against your rules. You review what comes in and approve it, or send it back with a note.',
    points: [
      ['Your comp in Battle Builder', 'so lists arrive already checked'],
      ['Approve or send back', 'each list from the Attendees tab'],
    ],
    image: '/images/app/ipad-builder.webp',
    alt: 'Battle Builder on iPad with an army list, unit profiles and points checks',
    wide: true,
    link: { label: 'Help: Reviewing army lists', href: `${HELP}reviewing-army-lists` },
  },
  {
    pill: 'Pairings and Battle Hub',
    title: 'Pairings, and the Battle Hub for Players',
    body: 'Pair each round with Swiss pairings, lock tables or move players by hand, then publish. Every player gets their pairing, table and opponent in the Battle Hub, with a push notification and an email.',
    points: [
      ['Swiss pairings', 'with table locks and manual swaps'],
      ['Players enter their own results', 'in the Battle Hub'],
      ['Call the TO', 'from a player\'s phone to their table'],
    ],
    image: '/images/hero/battle-hub.webp',
    alt: 'The Battle Hub on phones: list approved, the round timer, the match and Call the TO',
    wide: true,
    link: { label: 'Help: Running pairings on game day', href: `${HELP}running-game-day-pairings` },
  },
  {
    pill: 'Battle Scorer',
    title: 'Battle Scorer Results Straight to You',
    body: 'Players can play their round in the Battle Scorer from the Battle Hub. When they finish, the result and its full breakdown come straight to you, so you can see where every point came from.',
    points: [
      ['No typing scores in twice', 'the result arrives with the breakdown'],
      ['Scenario and lists', 'come with the round'],
    ],
    image: '/images/battle-scorer/battle-hub.webp',
    alt: 'The Battle Hub after a Battle Scorer game: result in, with the score breakdown',
    link: { label: 'See what the Battle Scorer does', href: '/battle-scorer/' },
  },
  {
    pill: 'Battle Board',
    title: 'The Battle Board on Your Venue Screen',
    body: 'Put the Battle Board on a TV or projector and it runs itself: the round timer, pairings with table numbers next to the scenario, results as they come in, standings between rounds, your announcements, and the final results at the end.',
    points: [
      ['Updates live', 'as you pair, start and score rounds'],
      ['Announcements', 'pushed to the screen from your dashboard'],
    ],
    image: '/images/for-tournament-organisers/for-tos-4.png',
    alt: 'The Battle Board showing the round timer and the scenario for round 1',
    wide: true,
    link: { label: 'Help: The Battle Board', href: `${HELP}the-battle-board-venue-screen` },
  },
];

const extraFeatures = [
  { title: 'Check-in on the Day', description: 'Check players in, add late arrivals and drop no-shows.', href: `${HELP}game-day-checking-players-in` },
  { title: 'Scoring Your Way', description: 'Matched Play, 20-0 or Win-Loss-Draw, with soft scores and votes.', href: `${HELP}scoring-setup` },
  { title: 'Scenarios per Round', description: 'Give each round its scenario, deployment map and notes.', href: `${HELP}rounds` },
  { title: 'Co-organisers', description: 'Share the dashboard with your co-TOs and add a ringer.', href: `${HELP}staff` },
  { title: 'Standings and Tiebreakers', description: 'Live standings with Strength of Schedule and head-to-head.', href: `${HELP}faq-pairings-tiebreakers-strength-of-schedule` },
  { title: 'Results to the Rankings', description: 'Finish the event and results go into the rankings.', href: `${HELP}finishing-the-event` },
];

// From owr-marketing testimonials.json (q007, q023, q026); used_in records website:/tournament-organisers.
const quotes = [
  { quote: "I'm the TO from the tournament and I am very happy with the app. From my side everything worked really well!", credit: 'TO, Invasion Old World 2026' },
  { quote: 'The app and battle hub were great. No issues and everyone has gotten used to entering the results and secondary/soft scores.', credit: 'TO, The Clash of Kings' },
  { quote: 'First time using old world rankings to hopefully make it a little easier than my spreadsheet fest of last year!', credit: "TO, Winchester's Battle March Bonanza" },
];
---

<Layout
  title="Host Your Event - Old World Rankings"
  description="Host your Warhammer: The Old World event on OWR for free: registrations and payments, custom comps checked in Battle Builder, Swiss pairings, the Battle Hub, Battle Scorer results and a live Battle Board."
>
  <Nav />

  <main>
    <!-- HERO - Dark bg with crosshatch pattern -->
    <section class="relative pt-32 pb-20 sm:pt-40 sm:pb-28 overflow-hidden">
      <!-- Gallery photos crossfading behind a dark, lightly blurred wash so the heading reads in both themes -->
      <div class="absolute inset-0 bg-gray-900 overflow-hidden" aria-hidden="true">
        {galleryPhotos.map((photo, i) => (
          <img
            src={photo.src}
            alt=""
            class:list={['gallery-slide absolute inset-0 w-full h-full object-cover scale-105 blur-[2px] transition-opacity duration-[1500ms]', i === 0 ? 'opacity-100' : 'opacity-0']}
            loading={i === 0 ? 'eager' : 'lazy'}
          />
        ))}
        <div class="absolute inset-0 bg-gray-900/70"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-gray-900/50 via-transparent to-gray-900"></div>
      </div>
      <p class="absolute bottom-3 right-4 z-10 text-[11px] text-white/50">
        From OWR galleries. <span id="gallery-credit">{galleryPhotos[0].credit}</span>
      </p>
      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/10 text-white text-sm font-medium mb-6">
          For Tournament Organisers
        </span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-6 max-w-3xl mx-auto">
          Host Your Event on OWR
        </h1>
        <p class="text-lg text-gray-300 max-w-2xl mx-auto mb-4">
          Registrations, list checks, pairings, results and a big screen for the venue, all in one place. You run the day, OWR does the admin.
        </p>
        <p class="text-lg font-semibold text-owr-gold mb-10">Hosting on OWR is free.</p>
        <div class="flex justify-center mb-16">
          <a
            href={`${APP_URL}/host`}
            class="px-10 py-4 bg-owr-gold text-gray-900 font-semibold rounded-lg hover:bg-owr-gold-dark transition-colors text-center text-lg"
          >
            Host Your Event
          </a>
        </div>

        <!-- Highlight cards -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 max-w-4xl mx-auto">
          {highlights.map((h) => (
            <div class="p-4 rounded-xl bg-white/5 border border-white/10 text-left">
              <svg class="h-6 w-6 text-owr-gold mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d={h.icon} />
              </svg>
              <h3 class="text-sm font-semibold text-white mb-1">{h.title}</h3>
              <p class="text-xs text-gray-400">{h.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- LIFECYCLE PROGRESS BAR -->
    <section class="py-16 sm:py-20 bg-white dark:bg-gray-900">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-4">
            From Player Pack to Podium
          </h2>
          <p class="text-gray-500 dark:text-gray-400 max-w-xl mx-auto">
            Set your event up, run game day, and the results go into the rankings when you finish.
            <a href={`${HELP}hosting-an-event-start-here`} target="_blank" rel="noopener noreferrer" class="text-owr-gold-dark dark:text-owr-gold font-semibold hover:underline">Start here</a>
          </p>
        </div>

        <div class="flex items-center justify-between max-w-xs sm:max-w-2xl mx-auto px-2 sm:px-0">
          {lifecycleSteps.map((step, i) => (
            <div class="flex items-center flex-1 last:flex-none">
              <div class="flex flex-col items-center">
                <div class="w-10 h-10 rounded-full bg-owr-gold text-gray-900 font-bold text-sm flex items-center justify-center shrink-0">
                  {step.number}
                </div>
                <span class="text-xs font-medium text-gray-600 dark:text-gray-400 mt-2 whitespace-nowrap">{step.label}</span>
              </div>
              {i < lifecycleSteps.length - 1 && (
                <div class="flex-1 h-0.5 bg-owr-gold/30 mx-2 sm:mx-4 mb-6 min-w-4"></div>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <FeatureRows sections={sections} />

    <Testimonials title="What TOs Say" quotes={quotes} />

    <!-- FEATURE GRID - white bg -->
    <section class="py-16 sm:py-24 bg-white dark:bg-gray-900 scroll-mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-4">
            Everything Else You Need
          </h2>
          <p class="text-gray-500 dark:text-gray-400 max-w-xl mx-auto">
            Each one links to its guide in the help centre.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {extraFeatures.map((feature) => (
            <a href={feature.href} target="_blank" rel="noopener noreferrer" class="block p-6 rounded-xl border border-gray-200 bg-gray-50 dark:bg-gray-800 dark:border-gray-700 hover:border-gray-400 dark:hover:border-gray-500 transition-all">
              <h3 class="font-semibold text-gray-900 dark:text-white mb-2">{feature.title}</h3>
              <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">{feature.description}</p>
              <span class="inline-block mt-3 text-sm font-semibold text-owr-gold-dark dark:text-owr-gold">Read the guide &rarr;</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- PRO EXTRAS - gray-50 bg -->
    <section class="py-16 sm:py-24 bg-gray-50 dark:bg-gray-800 scroll-mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-4">
            Want More? See What Pro Adds
          </h2>
          <p class="text-gray-500 dark:text-gray-400 max-w-xl mx-auto">
            Everything above comes with hosting, which is free. OWR Pro adds a few extras for TOs who want them.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {proExtras.map((extra) => (
            <div class="p-6 rounded-xl border border-gray-200 bg-white dark:bg-gray-900 dark:border-gray-700">
              <h3 class="font-semibold text-gray-900 dark:text-white mb-2">{extra.title}</h3>
              <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">{extra.description}</p>
            </div>
          ))}
        </div>

        <div class="text-center mt-10">
          <a href="/pricing/" class="inline-block px-8 py-3 border border-gray-300 dark:border-white/30 text-gray-900 dark:text-white font-medium rounded-lg hover:bg-gray-100 dark:hover:bg-white/10 transition-colors">
            See OWR Pro
          </a>
        </div>
      </div>
    </section>

    <!-- FINAL CTA - Dark bg -->
    <section class="relative py-20 sm:py-28 overflow-hidden">
      <div class="absolute inset-0 bg-gray-900">
        <div class="absolute inset-0 opacity-5 bg-[url('data:image/svg+xml;base64,')]"></div>
      </div>
      <div class="relative z-10 max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white mb-6">
          Ready to Run Your Next Event?
        </h2>
        <p class="text-lg text-gray-400 mb-10 max-w-xl mx-auto">
          Hosting is free. Create your event in a few minutes, set it up at your own pace, and publish it when you're ready.
        </p>
        <a
          href={`${APP_URL}/host`}
          class="inline-block px-10 py-4 bg-owr-gold text-gray-900 font-semibold rounded-lg hover:bg-owr-gold-dark transition-colors text-lg"
        >
          Host Your Event
        </a>
      </div>
    </section>
  </main>

  <Footer />

</Layout>

<script>
  // Crossfade the hero gallery photos with their credit; hold the first one for anyone who prefers less motion.
  const credits = ['Daemons of Chaos: Player, United States','Chracian Warhost: Player, Australia','Warriors of Chaos: Player, Canada','Daemons of Chaos: Player, Canada','Chracian Warhost: Player, Australia'];
  const credit = document.getElementById('gallery-credit');
  const slides = document.querySelectorAll('.gallery-slide');
  if (slides.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let current = 0;
    setInterval(() => {
      slides[current].classList.replace('opacity-100', 'opacity-0');
      current = (current + 1) % slides.length;
      slides[current].classList.replace('opacity-0', 'opacity-100');
      if (credit) credit.textContent = credits[current];
    }, 6000);
  }
</script>
