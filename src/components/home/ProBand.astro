---
const APP_URL = import.meta.env.PUBLIC_APP_URL || 'https://oldworldrankings.com';
---

<section id="pro" class="bg-owr-gold text-gray-900 scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-5 flex flex-col md:flex-row md:items-center gap-3 md:gap-6">
    <p class="flex-1 text-sm sm:text-[15px] leading-snug">
      <span class="font-extrabold uppercase tracking-wide mr-2">OWR Pro</span>
      Support the continued development of the Old World Rankings community, and unlock Digital Lists, Builder Sync, Battle Hub Scorer and more.
      <span class="font-semibold whitespace-nowrap">From <span data-pro-price>$5.83</span>/month, billed yearly.</span>
    </p>
    <div class="flex items-center gap-4 shrink-0">
      <a href={`${APP_URL}/purchase`} class="h-10 flex items-center px-4 rounded-lg bg-gray-900 hover:bg-black text-owr-gold font-bold text-sm transition-colors">Upgrade to Pro</a>
      <a href="/pricing/" class="text-sm font-semibold underline underline-offset-4 hover:no-underline">Compare plans</a>
    </div>
  </div>
</section>

<script>
  import { detectCurrency, priceForCurrency } from '../../lib/pricing';

  function render() {
    if (window.__owrUser?.pro) {
      document.getElementById('pro')?.remove();
      return;
    }
    const price = priceForCurrency(detectCurrency(window.__owrUser?.region_slug), 'yearly');
    document.querySelector('#pro [data-pro-price]')?.replaceChildren(price.display);
  }

  document.addEventListener('owr:user-loaded', render);
  if (window.__owrUser !== undefined) render();
</script>
