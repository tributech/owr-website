---
// Temporary Battle Scorer launch takeover: replaces the top of the home page,
// with looping device clips. The usual hero follows it.
import { ArrowRight, ChevronDown, Hammer, CalendarArrowUp, Landmark, Trophy, MapPin } from '@lucide/astro';
import { APP_STORE_URL, PLAY_STORE_URL } from '../../lib/store-links';

const APP_URL = import.meta.env.PUBLIC_APP_URL || 'https://oldworldrankings.com';
const startHref = `${APP_URL}/builder/games`;
const moreHref = '/battle-scorer/';

// Quick routes out of the takeover for people who came for the usual home page.
const jumps = [
  { label: 'Battle Builder', href: `${APP_URL}/builder`, icon: Hammer, color: 'text-owr-gold' },
  { label: 'Find an event', href: `${APP_URL}/upcoming`, icon: CalendarArrowUp, color: 'text-teal-400' },
  { label: 'Host an event', href: `${APP_URL}/host`, icon: Landmark, color: 'text-purple-400' },
  { label: 'Rankings', href: `${APP_URL}/global_rankings`, icon: Trophy, color: 'text-amber-400' },
  { label: 'Your region', href: '#home-main', icon: MapPin, color: 'text-sky-400' },
];

const points = [
  'Both armies, spells and casting odds in one place',
  'Victory Points and objectives added up for you',
  'One tap to send your result to the TO at OWR events',
];
---

<section class="relative overflow-hidden bg-black text-white pt-16">
  <div class="absolute inset-0" aria-hidden="true">
    <img src="/images/landing/image3.jpg" alt="" class="absolute inset-0 w-full h-full object-cover opacity-[0.12]" />
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_72%_45%,rgba(255,215,0,0.22),transparent_55%)]"></div>
    <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-b from-transparent to-black"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 sm:pt-16 pb-12 sm:pb-16 lg:min-h-[calc(100vh-9rem)] lg:max-h-[820px] grid grid-cols-1 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-10 lg:gap-8 items-center">
    <div>
      <span class="inline-flex items-center gap-2 rounded-full border border-owr-gold/50 bg-owr-gold/10 px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-owr-gold">
        <span class="size-1.5 rounded-full bg-owr-gold animate-pulse"></span> Just launched
      </span>
      <h2 class="mt-4 text-5xl sm:text-6xl xl:text-7xl font-extrabold tracking-tight leading-[0.95]">The Battle Scorer</h2>
      <p class="mt-4 text-xl sm:text-2xl font-bold text-owr-gold">Playing The Old World will never be the same.</p>
      <p class="mt-4 text-base sm:text-lg text-white/70 max-w-xl">Score any game on your phone, tablet or the web. A pick-up game at your club, practice at home, or a round at an event.</p>
      <ul class="hidden sm:block mt-6 space-y-2.5">
        {points.map((p) => (
          <li class="flex gap-3 text-white/90"><span class="mt-2 size-1.5 shrink-0 rotate-45 bg-owr-gold"></span>{p}</li>
        ))}
      </ul>
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
        <a href={startHref} class="h-12 flex items-center gap-2 px-6 rounded-lg bg-owr-gold hover:bg-owr-gold-dark text-gray-900 font-extrabold text-lg shadow-[0_0_30px_-6px_rgba(255,215,0,0.6)] transition-colors">Start a game <ArrowRight size={18} strokeWidth={2.5} /></a>
        <a href={moreHref} class="font-semibold text-white/80 hover:text-owr-gold underline underline-offset-4">See what it does</a>
      </div>
      <div id="app" class="mt-7 flex items-center gap-3 scroll-mt-24">
        <a href={APP_STORE_URL} target="_blank" rel="noopener noreferrer"><img src="/images/store/app-store-badge.svg" alt="Download on the App Store" class="h-10 w-auto" /></a>
        <a href={PLAY_STORE_URL} target="_blank" rel="noopener noreferrer"><img src="/images/store/google-play-badge.svg" alt="Get it on Google Play" class="h-10 w-auto" /></a>
        <span class="hidden sm:inline text-xs text-white/50">or on the web</span>
      </div>
    </div>

    <div class="relative pb-10 sm:pb-14 lg:pl-6" aria-hidden="true">
      <div class="rounded-[1.6rem] sm:rounded-[2rem] border-[8px] sm:border-[12px] border-neutral-800 bg-black shadow-[0_30px_80px_rgba(0,0,0,0.8)] overflow-hidden">
        <video class="scorer-loop block w-full aspect-[4/3]" src="/images/scorer/ipad-loop.mp4" poster="/images/scorer/ipad-loop.webp" autoplay muted loop playsinline preload="auto"></video>
      </div>
      <div class="absolute -left-2 sm:-left-6 bottom-0 w-[30%] sm:w-[26%] rounded-[1.4rem] sm:rounded-[2rem] border-[5px] sm:border-[7px] border-neutral-800 bg-black shadow-[0_25px_60px_rgba(0,0,0,0.85)] overflow-hidden">
        <video class="scorer-loop block w-full aspect-[420/914]" src="/images/scorer/iphone-loop.mp4" poster="/images/scorer/iphone-loop.webp" autoplay muted loop playsinline preload="auto"></video>
      </div>
    </div>
  </div>

  <div class="relative border-t border-white/10 bg-white/[0.04] backdrop-blur">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-col md:flex-row md:items-center gap-3 md:gap-5">
      <p class="text-sm font-semibold text-white/70 shrink-0">Here for something else?</p>
      <nav aria-label="Jump to" class="flex gap-2 overflow-x-auto -mx-4 px-4 md:mx-0 md:px-0 md:flex-1">
        {jumps.map((j) => (
          <a href={j.href} class="shrink-0 h-9 flex items-center gap-1.5 px-3.5 rounded-full bg-white/10 border border-white/15 hover:bg-white/[0.16] text-[13px] font-semibold text-white transition-colors">
            <span class={j.color}><j.icon size={15} strokeWidth={2} /></span>{j.label}
          </a>
        ))}
      </nav>
      <a href="#home-main" class="group shrink-0 h-11 flex items-center justify-center gap-2 px-5 rounded-lg border-2 border-white/70 hover:border-owr-gold hover:text-owr-gold text-white font-bold text-sm transition-colors">
        Rankings, events and more <ChevronDown size={18} strokeWidth={2.5} class="group-hover:translate-y-0.5 transition-transform" />
      </a>
    </div>
  </div>
</section>

<script>
  // Hold the device clips on their first frame for anyone who prefers less motion.
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLVideoElement>('video.scorer-loop').forEach((v) => { v.pause(); v.removeAttribute('autoplay'); });
  }
</script>
