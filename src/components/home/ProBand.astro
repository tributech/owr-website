---
import { Check } from '@lucide/astro';

const APP_URL = import.meta.env.PUBLIC_APP_URL || 'https://oldworldrankings.com';

const perks = [
  'Digital Lists',
  'Army Builder Sync',
  'Early Army List Access',
  'Battle Hub Scorer',
  'Tournament Pack AI Assist',
  'Ad-free',
];
---

<section id="pro" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 sm:pt-20 scroll-mt-20">
  <div class="rounded-xl border-2 border-owr-gold/60 bg-white shadow-sm dark:bg-white/5 dark:shadow-[0_0_30px_rgba(255,215,0,0.08)] p-6 sm:p-8 flex flex-col lg:flex-row lg:items-center gap-6 lg:gap-10">
    <div class="lg:w-[42%] flex flex-col gap-3">
      <div class="flex items-center gap-2">
        <span class="text-xs font-bold uppercase tracking-widest text-owr-gold-dark dark:text-owr-gold">OWR Pro</span>
        <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-green-100 text-green-800">Introductory pricing</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 dark:text-white">Take your game further.</h2>
      <p class="text-[15px] leading-relaxed text-gray-600 dark:text-white/70">Everything in Free, plus the tools serious players and organisers use every week. Pro also funds the continued development of OWR.</p>
      <p class="flex items-baseline gap-1.5 text-gray-900 dark:text-white">
        <span class="text-sm text-gray-500 dark:text-gray-400">From</span>
        <span data-pro-price class="text-3xl font-extrabold">$6.99</span>
        <span data-pro-suffix class="text-sm text-gray-500 dark:text-gray-400">USD/month</span>
      </p>
      <div class="flex flex-wrap gap-2.5">
        <a href={`${APP_URL}/purchase`} class="h-11 flex items-center px-5 rounded-lg bg-owr-gold hover:bg-owr-gold-dark text-gray-900 font-bold text-sm transition-colors">Upgrade to Pro</a>
        <a href="/pricing/" class="h-11 flex items-center px-5 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-900 dark:bg-white/10 dark:hover:bg-white/15 dark:text-white font-semibold text-sm transition-colors">Compare plans</a>
      </div>
    </div>
    <ul class="flex-1 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3">
      {perks.map((perk) => (
        <li class="flex items-center gap-3 text-[15px] font-semibold text-gray-900 dark:text-white">
          <span class="shrink-0 w-6 h-6 rounded-full bg-owr-gold/20 text-owr-gold-dark dark:text-owr-gold flex items-center justify-center"><Check size={14} strokeWidth={3} /></span>
          {perk}
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import { detectCurrency, priceForCurrency } from '../../lib/pricing';

  function render() {
    if (window.__owrUser?.pro) {
      document.getElementById('pro')?.remove();
      return;
    }
    const price = priceForCurrency(detectCurrency(window.__owrUser?.region_slug));
    const section = document.getElementById('pro');
    section?.querySelector('[data-pro-price]')?.replaceChildren(price.display);
    section?.querySelector('[data-pro-suffix]')?.replaceChildren(price.suffix);
  }

  document.addEventListener('owr:user-loaded', render);
  if (window.__owrUser !== undefined) render();
</script>
